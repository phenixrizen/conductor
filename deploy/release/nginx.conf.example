# Include inside nginx's http block after configuring certificates and DNS.
# Replace this synthetic hostname and certificate paths. No operations listener
# is proxied. Serve the API and browser from the exact configured HTTPS origin.
server {
    listen 443 ssl;
    server_name conductor.example.invalid;
    ssl_certificate /etc/nginx/tls/conductor.pem;
    ssl_certificate_key /etc/nginx/tls/conductor-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/conductor/current/web;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    location /api/ {
        client_max_body_size 20m;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
    }
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
