# Create a DIFFERENT protected environment file and credential directory for each
# service. Keep only the service's own credential setting from the choices below.
DATABASE_URL=postgres://conductor_worker@database.example.invalid:5432/conductor?sslmode=verify-full
CONDUCTOR_TEMPORAL_MODE=remote-tls
CONDUCTOR_TEMPORAL_ADDRESS=temporal.example.invalid:7233
CONDUCTOR_TEMPORAL_NAMESPACE=conductor
CONDUCTOR_TEMPORAL_SERVER_NAME=temporal.example.invalid
CONDUCTOR_TEMPORAL_CA_FILE=/etc/conductor/SERVICE/temporal-ca.pem
CONDUCTOR_TEMPORAL_CLIENT_CERT_FILE=/etc/conductor/SERVICE/temporal-client.pem
CONDUCTOR_TEMPORAL_CLIENT_KEY_FILE=/etc/conductor/SERVICE/temporal-client-key.pem
# Context worker only; also configure the exact native CodeGraph image.
# CONDUCTOR_CONTEXT_CREDENTIALS_FILE=/etc/conductor/conductor-worker/credentials.json
# Executor: use the exact operator profile/credential settings in coordinated-execution.md.
# Publisher only:
# CONDUCTOR_PUBLICATION_CREDENTIALS_FILE=/etc/conductor/conductor-publisher/credentials.json
# Tracker only; separate from repository webhook port 8091:
# CONDUCTOR_TRACKER_CREDENTIALS_FILE=/etc/conductor/conductor-tracker-worker/credentials.json
# CONDUCTOR_TRACKER_WEBHOOK_ADDRESS=127.0.0.1:8092
# Runtime collector only:
# CONDUCTOR_RUNTIME_CREDENTIALS_FILE=/etc/conductor/conductor-runtime-worker/credentials.json
