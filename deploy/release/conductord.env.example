# Copy to a protected /etc/conductor/conductord.env and replace synthetic values.
DATABASE_URL=postgres://conductor_api@database.example.invalid:5432/conductor?sslmode=verify-full
CONDUCTOR_AUTH_MODE=oidc
CONDUCTOR_ADDR=127.0.0.1:8080
CONDUCTOR_OPERATIONS_ADDR=127.0.0.1:9090
CONDUCTOR_OIDC_ISSUER=https://identity.example.invalid
CONDUCTOR_OIDC_AUDIENCE=conductor-api
CONDUCTOR_PUBLIC_ORIGIN=https://conductor.example.invalid
CONDUCTOR_OIDC_CLIENT_ID=conductor-browser
CONDUCTOR_OIDC_CLIENT_SECRET_FILE=/etc/conductor/conductord/client-secret
CONDUCTOR_CONTEXT_COLLECTIONS=1
CONDUCTOR_COORDINATION=1
CONDUCTOR_DELIVERIES=1
CONDUCTOR_RUNTIME_EVIDENCE=1
